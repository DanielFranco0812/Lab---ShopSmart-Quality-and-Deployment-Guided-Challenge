# Keeps the Express API running and starts it again after a crash or a reboot.
# Settings come from backend/.env (loaded by the app itself).
[Unit]
Description=ShopSmart Express API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/shopsmart/backend
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
