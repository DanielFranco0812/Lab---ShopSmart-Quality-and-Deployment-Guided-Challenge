DATABASE_URL="postgresql://shopsmart_user:shopsmart_dev@localhost:5432/shopsmart?schema=public"
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Sign-in sessions. REQUIRED when NODE_ENV=production: a random value of at least 32 characters.
# Create one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set TRUST_PROXY=1 when the API runs behind a web server such as Caddy or nginx (the hosted version).
TRUST_PROXY=

# Optional AI provider. Leave GEMINI_API_KEY empty to use the labeled catalog-rules answers instead.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=25000
GEMINI_THINKING_LEVEL=low
